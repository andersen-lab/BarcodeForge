include README.md
include LICENSE
include pyproject.toml

# Include package data
recursive-include barcodeforge *.py

# Include tests
recursive-include tests *.py

# Exclude unnecessary files
global-exclude *.pyc
global-exclude *.pyo
global-exclude *~
global-exclude __pycache__
global-exclude .git*
global-exclude .DS_Store
prune .git
prune __pycache__
prune *.egg-info
prune barcodeforge/assets
